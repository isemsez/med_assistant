# Copy to .env and adjust. Endpoints are OpenAI-compatible
# (/v1/chat/completions, /v1/embeddings).

# Answerer: MedGemma 1.5 4B on CPU — MAIN Ollama instance (auto-starts).
CANDIDATE_BASE_URL=http://localhost:11434/v1
CANDIDATE_MODEL=medgemma-cpu
CANDIDATE_API_KEY=ollama
# JSON merged into every answerer chat payload (provider-specific switches)
# CANDIDATE_EXTRA_BODY={}

# Labeler (two calls: disease extraction + candidate selection): thinking-off
# medgemma on a SECOND Ollama instance with the iGPU — see scripts/start_labeler_ollama.ps1
LABELER_BASE_URL=http://127.0.0.1:11435/v1
LABELER_MODEL=medgemma-labeler
LABELER_API_KEY=ollama
# LABELER_EXTRA_BODY={}

# Embeddings for the guideline index (bge-m3 on the MAIN instance; a different
# blob from the answerer, no runner-reuse conflict). If RAM pressure evicts the
# answerer, move bge-m3 to the :11435 instance and change the URL.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
EMBED_API_KEY=ollama

# Paths (defaults shown)
# DOCS_META=data/docs_meta.json
# ABBR_PATH=data/abbr2term.yaml
# INDEX_DIR=data/index
# CLINREC_DIR=data/clinrec_minzdrav   # local guideline PDFs, served at /data/pdf
# SESSIONS_DB=data/sessions.sqlite
# AUDIT_LOG=logs/audit.jsonl

# Pipeline knobs (defaults shown)
# HISTORY_WINDOW=6        # messages of context sent to the answerer
# DISEASE_CAP=3           # max diseases processed per answer
# TOP_K=5                 # guideline candidates per disease
# AUTO_PICK=1             # 0 disables; skip labeler 2 when one candidate dominates
# AUTO_PICK_MIN=0.80      # top-1 cosine score required for auto-pick
# AUTO_PICK_GAP=0.05      # required lead of top-1 over the runner-up
