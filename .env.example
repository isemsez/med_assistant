# Copy to .env and adjust. Endpoints are OpenAI-compatible
# (/v1/chat/completions, /v1/embeddings).

# Answerer: MedGemma 1.5 4B on CPU — MAIN Ollama instance (auto-starts).
CANDIDATE_BASE_URL=http://localhost:11434/v1
CANDIDATE_MODEL=medgemma-cpu
CANDIDATE_API_KEY=ollama
# JSON merged into every answerer chat payload (provider-specific switches)
# CANDIDATE_EXTRA_BODY={}

# Labeler (two calls: disease extraction + candidate selection): thinking-off
# medgemma on a SECOND Ollama instance with the iGPU — started by
# start_chat.ps1
LABELER_BASE_URL=http://127.0.0.1:11435/v1
LABELER_MODEL=medgemma-labeler
LABELER_API_KEY=ollama
# LABELER_EXTRA_BODY={}

# Embeddings for the guideline index (bge-m3 on the MAIN instance; a different
# blob from the answerer, no runner-reuse conflict). bge-cpu = bge-m3 with
# num_gpu 0: the embed model stays off the iGPU so it never competes with the
# labeler for the Vulkan allocation pool (models/bge-cpu.modelfile). If RAM
# pressure evicts the answerer, move it to the :11435 instance and change the
# URL.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-cpu
EMBED_API_KEY=ollama

# Paths (defaults shown)
# DOCS_META=data/docs_meta.json
# ABBR_PATH=data/abbr2term.yaml
# INDEX_DIR=data/index
# CLINREC_DIR=data/clinrec_minzdrav   # local guideline PDFs, served at /data/pdf
# SESSIONS_DB=data/sessions.sqlite
# AUDIT_LOG=logs/audit.jsonl
# CARD_DIR=data/patient_cards  # patient-card files (*.амбулаторная_карта.md), per-question prompt context
# CARD_MAX_CHARS=8000          # larger card files are rejected with HTTP 400
# DRUGS_DB=data/drugs.sqlite   # ГРЛС register sqlite (scripts/grls_to_sqlite.py);
                               # missing file = МНН lookup silently off
# DRUG_PS_MAX=5                # max trade-name -> МНН matches per question

# Pipeline knobs (defaults shown)
# ANSWERER_MAX_TOKENS=3072  # per-call generation cap (thinking+answer share it;
                            # num_ctx alone never bounds output - 2048 let a
                            # verbose thinking phase truncate the answer mid-word)
# HISTORY_WINDOW=6        # messages of context sent to the answerer
# DISEASE_CAP=3           # max diseases processed per answer
# TOP_K=5                 # guideline candidates per disease
# AUTO_PICK=1             # 0 disables; skip labeler 2 when one candidate dominates
# AUTO_PICK_MIN=0.80      # top-1 cosine score required for auto-pick
# AUTO_PICK_GAP=0.05      # required lead of top-1 over the runner-up

# Answerer thinking-loop watchdog (2026-10-06, redefined 2026-10-14): abort
# a degenerate pre-content reasoning loop (the same unit repeated
# back-to-back; scattered recurring phrases are NOT loops), retry once with
# an anti-repetition nudge, then fail with the honest error note.
# LOOP_GUARD=1                # 0 disables the watchdog
# LOOP_MIN_UNIT=8             # shortest repeated unit that counts as a loop
# LOOP_REPEATS=3              # consecutive back-to-back copies that trip
# LOOP_WINDOW_CHARS=4096      # rolling buffer size
# LOOP_RETRIES=1              # anti-loop retry attempts after abort
# LOOP_RETRY_FREQ_PENALTY=0.5 # frequency_penalty sent on the retry

# Observability / housekeeping (defaults shown)
# HEALTH_CACHE_S=30       # /api/health result cache seconds
# AUDIT_ROTATE_MB=10      # rotate audit.jsonl when it crosses this size
# AUDIT_KEEP=3            # rotated generations to keep
# SESSIONS_BACKUP_KEEP=5  # sessions.sqlite backups in data/backups/
