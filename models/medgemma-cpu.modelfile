# medgemma-cpu: text-only MedGemma 1.5 4B (vision projector stripped, see
# scripts/strip_vision_gguf.py) pinned to CPU via num_gpu 0; thinking on.
# Original definition: medgemma-cpu.backup.modelfile

FROM C:\Users\Malay\py\med_assistant\models\medgemma1.5-4b-q4km-text-only.gguf
TEMPLATE """{{- $lastUserIdx := -1 -}}
{{- $firstUserIdx := -1 -}}
{{- range $idx, $msg := .Messages -}}
{{- if eq $msg.Role "user" }}{{ if lt $firstUserIdx 0 }}{{ $firstUserIdx = $idx }}{{ end }}{{ $lastUserIdx = $idx }}{{ end -}}
{{- end }}
{{- range $i, $_ := .Messages }}
{{- $last := eq (len (slice $.Messages $i)) 1 }}
{{- if eq .Role "user" }}<start_of_turn>user
{{- if and (eq $i $firstUserIdx) (or $.Think $.System) }}{{ if $.Think }}SYSTEM INSTRUCTION: think silently if needed. {{ end }}{{ if $.System }}{{ $.System }}{{ else }}You are a helpful medical assistant.{{ end }}
{{ end }}{{ .Content }}<end_of_turn>
{{ else if eq .Role "assistant" }}<start_of_turn>model
{{ if (and $.IsThinkSet (and .Thinking (or $last (gt $i $lastUserIdx)))) -}}
<think>{{ .Thinking }}</think>
{{ end -}}
{{ .Content }}<end_of_turn>
{{ end }}
{{- if $last }}<start_of_turn>model
{{ if and $.IsThinkSet (not $.Think) -}}
<think>

</think>

{{ end -}}
{{ end }}
{{- end }}"""
PARAMETER stop <end_of_turn>
PARAMETER temperature 0
PARAMETER num_gpu 0
